# Build arguments
NEXT_PUBLIC_DEBUG=false

# Docker image version (leave empty for 'latest')
VERSION=

# Runtime environment
NODE_ENV=production
# --max-http-header-size only matters for `pnpm dev`; the production image always sets it
NODE_OPTIONS=--max-old-space-size=4096 --max-http-header-size=65536
HOSTNAME=0.0.0.0

# Site metadata
NEXT_PUBLIC_SITE_NAME=NextJS Image Processor
NEXT_PUBLIC_SITE_DESCRIPTION=A powerful web application for image processing
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_THEME_COLOR=#000000
NEXT_PUBLIC_SITE_BACKGROUND_COLOR=#ffffff
CLEANUP_API_KEY=change-this-to-a-secure-key
CLEANUP_CRON_SCHEDULE=*/30 * * * *
# Optional: enables POST /api/process; callers send "Authorization: Bearer <key>"
# PROCESS_API_KEY=
# Optional: cap on base64 characters per chunk for /api/process/uploads (e.g. behind nginx)
# UPLOAD_CHUNK_CHARS=
# Optional: key for signing "Delete All Files" tokens (random per start when unset)
# UPLOAD_TOKEN_SECRET=
