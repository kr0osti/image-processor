{
  "name": "my-v0-project",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@8.15.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "^8.15.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --config config/jest/jest.config.js",
    "test:watch": "jest --watch --config config/jest/jest.config.js",
    "test:coverage": "jest --coverage --config config/jest/jest.config.js",
    "test:e2e": "playwright test --config config/playwright/playwright.config.ts",
    "docker:dev": "cd docker && docker-compose -f docker-compose-dev.yml up --build",
